        <mxCell id="e-trunk-eval" value="汇入" style="endArrow=classic;html=1;rounded=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#F59E0B;strokeWidth=2.6;fontColor=#B45309;fontSize=10;" edge="1" parent="1" target="eval-set">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="595" as="sourcePoint"/>
          </mxGeometry>
        </mxCell>
        <!-- 需求制品数据 → 干线 起点（已在 1260 列上） -->
        <mxCell id="e-data-art-trunk" style="endArrow=none;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;strokeColor=#F59E0B;strokeWidth=2.2;" edge="1" parent="1" source="data-art">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1260" y="595" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- 紫色：Skill 版本 ⇄ 评测数据集（双向） -->
        <mxCell id="e-skill-eval" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#8B5CF6;strokeWidth=2;" edge="1" parent="1" source="skill-ver" target="eval-set">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-eval-skill" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.6;entryDx=0;entryDy=0;strokeColor=#8B5CF6;strokeWidth=2;" edge="1" parent="1" source="eval-set" target="skill-ver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 紫色：评测集 → 自进化引擎（行内） -->
        <mxCell id="e-eval-engine" value="驱动" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#8B5CF6;strokeWidth=2.4;fontColor=#6D28D9;fontSize=10;" edge="1" parent="1" source="eval-set" target="engine">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 紫色：自进化引擎 → Skill 版本（底部 y=820 反向轨道） -->
        <mxCell id="e-engine-skill" value="③ 自动更新 Skill / Prompt" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#8B5CF6;strokeWidth=2.6;fontColor=#6D28D9;fontSize=11;fontStyle=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="engine" target="skill-ver">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1500" y="820"/>
              <mxPoint x="1020" y="820"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 绿色：Skill 版本 → Git（共用 x=1020 竖直直下） -->
        <mxCell id="e-skill-git" value="入库" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#22C55E;strokeWidth=2.6;fontColor=#15803D;fontSize=11;fontStyle=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="skill-ver" target="ci-git">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1020" y="850"/>
              <mxPoint x="980" y="850"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 绿色行内：Git → Stream → Knot → 回灌（右→左） -->
        <mxCell id="e-git-stream" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#22C55E;strokeWidth=2.6;" edge="1" parent="1" source="ci-git" target="ci-stream">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-stream-knot" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#22C55E;strokeWidth=2.6;" edge="1" parent="1" source="ci-stream" target="ci-knot">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-knot-ship" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#22C55E;strokeWidth=2.6;" edge="1" parent="1" source="ci-knot" target="ci-ship">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 绿色：回灌 → 会话（沿 x=160 左边缘上行） -->
        <mxCell id="e-ship-session" value="④ 升级回灌生产" style="endArrow=classic;html=1;rounded=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#22C55E;strokeWidth=2.6;fontColor=#15803D;fontSize=11;fontStyle=1;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ci-ship" target="session">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="990"/>
              <mxPoint x="160" y="990"/>
              <mxPoint x="160" y="300"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============ 图例 ============ -->
        <mxCell id="legend" value="&lt;b&gt;闭环 4 步 · 自上而下叙事&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style='color:#1664FF;font-weight:bold'&gt;①&lt;/span&gt; 用户对话 → 会话 → 控制器 → MCP → TAPD（蓝色生成主链路）&lt;br&gt;&lt;span style='color:#F59E0B;font-weight:bold'&gt;②&lt;/span&gt; 会话/TAPD/评审纪要 → 三类数据采集（橙色，干线-枝线汇入评测）&lt;br&gt;&lt;span style='color:#8B5CF6;font-weight:bold'&gt;③&lt;/span&gt; 数据 → 评测集 → 自进化引擎 → 更新 Skill 版本（紫色）&lt;br&gt;&lt;span style='color:#22C55E;font-weight:bold'&gt;④&lt;/span&gt; Skill 版本 → Git → Stream → Knot → 回灌（绿色）" style="rounded=1;fillColor=#FFFFFF;strokeColor=#E5E6EB;fontSize=12;align=left;verticalAlign=top;spacingLeft=20;spacingTop=14;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="990" width="1420" height="170" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>

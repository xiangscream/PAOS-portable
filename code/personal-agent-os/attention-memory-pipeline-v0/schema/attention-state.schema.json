{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attention-state.schema.json",
  "title": "Attention State v0",
  "type": "object",
  "required": [
    "schema",
    "generated_at",
    "data_scope",
    "scan_summary",
    "changes",
    "tasks",
    "tips",
    "projects",
    "archives",
    "review_candidates",
    "source_index"
  ],
  "properties": {
    "schema": { "const": "attention-state/v0" },
    "generated_at": { "type": "string" },
    "data_scope": { "const": "synthetic-only" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "domain_code",
          "domain",
          "project",
          "status",
          "review_state",
          "source_refs"
        ],
        "properties": {
          "kind": { "const": "task" },
          "current_question": { "type": "string" },
          "deliverable": { "type": "string" },
          "done_when": { "type": "string" },
          "source_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "source_refs"],
        "properties": {
          "kind": { "const": "tip" },
          "source_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "review_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "candidate_type",
          "status",
          "reason",
          "source_refs"
        ],
        "properties": {
          "status": { "const": "candidate" },
          "source_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}

